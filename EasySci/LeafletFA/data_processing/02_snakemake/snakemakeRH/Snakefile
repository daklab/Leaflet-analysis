import os

configfile: "Easysci.yaml"

# Function to extract sample IDs dynamically
def get_sample_ids():
    bam_directory = config["bam_files"]
    sample_ids = set()
    
    for subdir, _, files in os.walk(bam_directory):
        bam_files = [f for f in files if f.endswith(".bam")]
        bai_files = [f for f in files if f.endswith(".bai")]
        
        # Only include directories where there's exactly one BAM and one BAI
        if len(bam_files) == 1 and len(bai_files) == 1:
            sample_id = os.path.splitext(bam_files[0])[0]  # Remove .bam extension
            sample_ids.add(sample_id)
    
    return sorted(sample_ids)

# Extract sample IDs for dynamic rule creation
sample_ids = get_sample_ids()
print(f"The number of valid samples found: {len(sample_ids)}")
print(f"The first 10 valid samples: {sample_ids[:10]}")

# Rule to process all samples
rule all:
    input:
        expand(config["results_dir"] + "/{sample}/junctions.bed", sample=sample_ids),
        expand(config["results_dir"] + "/{sample}/barcodes.txt", sample=sample_ids),
        expand(config["results_dir"] + "/{sample}/junctions_with_barcodes.bed", sample=sample_ids),
        expand(config["results_dir"] + "/{sample}_splicing_summary.tsv", sample=sample_ids)

rule add_cb_tag:
    input:
        bam=os.path.join(config["bam_files"], "{sample}", "{sample}.bam")
    output:
        bam_CB=os.path.join(config["bam_files"], "{sample}", "{sample}_CB.bam")
    params:
        sample="{sample}"
    shell:
        """
        echo "Processing sample: {params.sample}"
        echo "Expected BAM path: {input.bam}"
        
        if [[ ! -f "{input.bam}" ]]; then
            echo "ERROR: BAM file {input.bam} not found!"
            exit 1
        fi
        
        samtools view -h {input.bam} | awk -v cb="{params.sample}" 'BEGIN {{OFS="\t"}} {{if ($1 ~ /^@/) print; else print $0 "\tCB:Z:" cb;}}' | samtools view -b - > {output.bam_CB}
        """

# Rule to index the BAM file
rule index_bam:
    input:
        bam=rules.add_cb_tag.output.bam_CB
    output:
        bai=os.path.join(config["bam_files"], "{sample}", "{sample}_CB.bam.bai")
    shell:
        """
        echo "Indexing BAM file: {input.bam}"
        samtools index {input.bam}
        """

# Rule to extract junctions with barcodes
rule extract_junctions:
    input:
        bam=rules.add_cb_tag.output.bam_CB,
        bai=rules.index_bam.output.bai
    output:
        juncs=config["results_dir"] + "/{sample}/junctions.bed",
        barcodes=config["results_dir"] + "/{sample}/barcodes.txt",
        juncswbarcodes=config["results_dir"] + "/{sample}/junctions_with_barcodes.bed"
    params:
        regtools_path=config["regtools_path"]
    shell:
        """
        mkdir -p $(dirname {output.juncs})
        
        echo "Extracting junctions with barcodes from BAM file: {input.bam}"
        {params.regtools_path} junctions extract -a 6 -m 50 -M 500000 {input.bam} -o {output.juncs} -s XS -b {output.barcodes}
        paste --delimiters='\t' {output.juncs} {output.barcodes} > {output.juncswbarcodes}
        
        echo "Done extracting junctions with barcodes"
        """

rule summarize_splicing:
    input:
        bam=rules.add_cb_tag.output.bam_CB,
        juncs=config["results_dir"] + "/{sample}/junctions.bed"
    output:
        summary=config["results_dir"] + "/{sample}_splicing_summary.tsv"
    shell:
        """
        echo -e "Sample\tTotal_Reads\tSpliced_Reads\tUnspliced_Reads" > {output.summary}
        
        sample=$(basename {input.bam} | sed 's/_CB.bam$//')
        total_reads=$(samtools view -c -F 4 {input.bam})
        
        spliced_reads=$(awk '{{ sum += $5 }} END {{ print (sum == "" ? 0 : sum) }}' "{input.juncs}")
        if [[ -z "$spliced_reads" || ! "$spliced_reads" =~ ^[0-9]+$ ]]; then
            spliced_reads=0
        fi
        
        unspliced_reads=$((total_reads - spliced_reads))
        
        echo -e "$sample\t$total_reads\t$spliced_reads\t$unspliced_reads" >> {output.summary}
        echo "Splicing summary written to {output.summary}"
        """

# Rule to clean up intermediate files (optional)
rule cleanup:
    input:
        bam=rules.add_cb_tag.output.bam_CB,
        bai=rules.index_bam.output.bai,
        summary=rules.summarize_splicing.output.summary
    shell:
        """
        echo "Cleaning up intermediate files..."
        rm -f {input.bam} {input.bai}
        echo "Cleanup complete"
        """