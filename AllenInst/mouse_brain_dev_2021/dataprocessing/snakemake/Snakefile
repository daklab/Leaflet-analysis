import os
import subprocess
import time

configfile: "config_mouse_brain_dev_2021.yaml"

def get_sample_ids():
    raw_dir = config["raw_dir"]
    sample_ids = []
    
    # Get list of all potential samples
    sample_list = [s for s in os.listdir(raw_dir) if s.startswith("SRR") and os.path.isdir(os.path.join(raw_dir, s))]
    total_samples = len(sample_list)
    
    print(f"Checking {total_samples} samples for valid FASTQ files...")
    
    start_time = time.time()

    for i, sample_id in enumerate(sample_list, start=1):
        full_path = os.path.join(raw_dir, sample_id)
        fastq1 = os.path.join(full_path, f"{sample_id}_1.fastq.gz")
        fastq2 = os.path.join(full_path, f"{sample_id}_2.fastq.gz")

        if os.path.exists(fastq1) and os.path.exists(fastq2):
            sample_ids.append(sample_id)

    print(f"Found {len(sample_ids)} samples.")
    return sample_ids

def validate_bam(bam_file):
    """Validate BAM file - check if it exists, has content, and is not corrupt"""
    if not os.path.exists(bam_file):
        return False
    
    # Check file size
    if os.path.getsize(bam_file) == 0:
        print(f"Warning: BAM file {bam_file} is empty (0 bytes)")
        return False
    
    # Check if BAM file is readable with samtools
    try:
        result = subprocess.run(['samtools', 'quickcheck', bam_file], 
                              capture_output=True, text=True, timeout=30)
        if result.returncode != 0:
            print(f"Warning: BAM file {bam_file} failed samtools quickcheck")
            return False
    except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
        print(f"Warning: Could not validate BAM file {bam_file}")
        return False
    
    return True

# Extract sample IDs (without validation)
sample_ids = get_sample_ids()

rule all:
    input:
        expand(os.path.join(config["results_dir"], "{sample}", "junctions.bed"), sample=sample_ids),
        expand(os.path.join(config["results_dir"], "{sample}", "barcodes.txt"), sample=sample_ids),
        expand(os.path.join(config["results_dir"], "{sample}", "junctions_with_barcodes.bed"), sample=sample_ids),
        expand(os.path.join(config["results_dir"], "{sample}", "splicing_summary.tsv"), sample=sample_ids)  

# Rule to generate STAR index
rule generate_star_index:
    output:
        flag = touch(config["star_index_dir"] + "/index_complete.flag")
    params:
        genome_fasta = config["genome_fasta"],
        gtf_file = config["gtf_file"]
    shell:
        """
        STAR --runThreadN 4 \
             --runMode genomeGenerate \
             --genomeDir {output[0]} \
             --genomeFastaFiles {params.genome_fasta} \
             --sjdbGTFfile {params.gtf_file}
        """

# STAR Alignment
rule run_star:
    input:
        star_index = rules.generate_star_index.output.flag,
        fastq1=os.path.join(config["raw_dir"], "{sample}", "{sample}_1.fastq.gz"),
        fastq2=os.path.join(config["raw_dir"], "{sample}", "{sample}_2.fastq.gz")
    output:
        bam=os.path.join(config["bam_files"], "{sample}", "Aligned.sortedByCoord.out.bam")
    params:
        star_index_dir=config['star_index_dir'],
        output_prefix=os.path.join(config["bam_files"], "{sample}/"),
        log=os.path.join(config["bam_files"], "{sample}", "run_star.log")  # Log file per sample
    shell:
        """
        echo "Running STAR for {wildcards.sample}..." >> {params.log}
        STAR --genomeDir {params.star_index_dir} \
             --readFilesIn {input.fastq1} {input.fastq2} \
             --readFilesCommand zcat \
             --runMode alignReads \
             --outSAMattributes XS \
             --outSAMstrandField intronMotif \
             --limitBAMsortRAM 44006670219 \
             --outSAMtype BAM SortedByCoordinate \
             --runThreadN 4 \
             --genomeLoad NoSharedMemory \
            --twopassMode Basic \
             --outFileNamePrefix {params.output_prefix}
        """

# New rule to validate BAM file
rule validate_bam:
    input:
        bam=rules.run_star.output.bam
    output:
        validated=os.path.join(config["bam_files"], "{sample}", "bam_validated.flag")
    run:
        if validate_bam(input.bam):
            # Create validation flag file
            with open(output.validated, 'w') as f:
                f.write(f"BAM file {input.bam} validated successfully\n")
            print(f"BAM validation passed for {wildcards.sample}")
        else:
            # Create empty outputs to prevent downstream rules from running
            print(f"BAM validation failed for {wildcards.sample}. Skipping downstream processing.")
            # Touch the flag file but mark it as failed
            with open(output.validated, 'w') as f:
                f.write(f"BAM file {input.bam} validation FAILED\n")

rule add_cb_tag:
    input:
        bam=rules.run_star.output.bam,
        validated=rules.validate_bam.output.validated
    output:
        bam_CB=os.path.join(config["bam_files"], "{sample}", "Aligned.sortedByCoord.out.bam.CB.bam")
    params:
        sample=lambda wildcards: wildcards.sample
    run:
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping CB tag addition for {wildcards.sample} due to failed BAM validation")
            # Create empty output file to satisfy Snakemake
            shell("touch {output.bam_CB}")
        else:
            print(f"Adding CB tag to BAM file: {input.bam}")
            shell("""
            samtools view -h {input.bam} | awk -v cb="{params.sample}" 'BEGIN {{OFS="\t"}} {{if ($1 ~ /^@/) print; else print $0 "\tCB:Z:" cb;}}' | samtools view -b - > {output.bam_CB}
            """)

# Rule to index BAM file
rule index_bam:
    input:
        bam=rules.add_cb_tag.output.bam_CB,
        validated=rules.validate_bam.output.validated
    output:
        bai=os.path.join(config["bam_files"], "{sample}", "Aligned.sortedByCoord.out.bam.CB.bam.bai")
    run:
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping BAM indexing for {wildcards.sample} due to failed BAM validation")
            # Create empty output file to satisfy Snakemake
            shell("touch {output.bai}")
        else:
            print(f"Indexing BAM file: {input.bam}")
            shell("samtools index {input.bam}")

rule extract_junctions:
    input:
        bam=rules.add_cb_tag.output.bam_CB,
        bai=rules.index_bam.output.bai,
        validated=rules.validate_bam.output.validated
    output:
        juncs=os.path.join(config["results_dir"], "{sample}", "junctions.bed"),
        barcodes=os.path.join(config["results_dir"], "{sample}", "barcodes.txt"),
        juncswbarcodes=os.path.join(config["results_dir"], "{sample}", "junctions_with_barcodes.bed")
    params:
        regtools_path=config["regtools_path"]
    run:
        shell("mkdir -p $(dirname {output.juncs})")
        
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping junction extraction for {wildcards.sample} due to failed BAM validation")
            # Create empty output files
            shell("touch {output.juncs} {output.barcodes} {output.juncswbarcodes}")
        else:
            print(f"Extracting junctions with barcodes from BAM file: {input.bam}")
            shell("""
            {params.regtools_path} junctions extract -a 6 -m 50 -M 500000 {input.bam} -o {output.juncs} -s XS -b {output.barcodes}
            paste --delimiters='\t' {output.juncs} {output.barcodes} > {output.juncswbarcodes}
            echo "Done extracting junctions with barcodes"
            """)

rule summarize_splicing:
    input:
        bam=os.path.join(config["bam_files"], "{sample}", "Aligned.sortedByCoord.out.bam.CB.bam"),
        juncs=os.path.join(config["results_dir"], "{sample}", "junctions.bed"),
        validated=rules.validate_bam.output.validated
    output:
        summary=os.path.join(config["results_dir"], "{sample}", "splicing_summary.tsv")
    run:
        shell("mkdir -p $(dirname {output.summary})")
        
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping splicing summary for {wildcards.sample} due to failed BAM validation")
            # Create summary with failure message
            with open(output.summary, 'w') as f:
                f.write("Sample\tTotal_Reads\tSpliced_Reads\tUnspliced_Reads\tStatus\n")
                f.write(f"{wildcards.sample}\t0\t0\t0\tBAM_VALIDATION_FAILED\n")
        else:
            shell("""
            echo -e "Sample\tTotal_Reads\tSpliced_Reads\tUnspliced_Reads\tStatus" > {output.summary}

            sample=$(basename {input.bam} | cut -d'.' -f1)
            total_reads=$(samtools view -c -F 4 {input.bam})

            # Ensure the file has at least five columns before extracting spliced reads
            spliced_reads=$(awk '{{ sum += $5 }} END {{ print (sum == "" ? 0 : sum) }}' "{input.juncs}")

            # Ensure spliced_reads is not empty or invalid
            if [[ -z "$spliced_reads" || ! "$spliced_reads" =~ ^[0-9]+$ ]]; then
                spliced_reads=0
            fi

            unspliced_reads=$((total_reads - spliced_reads))

            echo -e "$sample\t$total_reads\t$spliced_reads\t$unspliced_reads\tSUCCESS" >> {output.summary}
            echo "Splicing summary written to {output.summary}"
            """)