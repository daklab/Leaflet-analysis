   ],
   "source": [
    "def to_np(x):\n",
    "    return x.detach().cpu().numpy() if torch.is_tensor(x) else np.asarray(x)\n",
    "\n",
    "psi = to_np(model.psi)            # (K, J) program × junction\n",
    "phi = to_np(model.assign_post)    # (N, K) cell × program\n",
    "pi_ = to_np(model.pi)             # (K,)   global program weights\n",
    "\n",
    "print(f\"psi {psi.shape}  range {psi.min():.3f}–{psi.max():.3f}\")\n",
    "print(f\"phi {phi.shape}  row sums ~1: {phi.sum(1)[:3].round(3)}\")\n",
    "print(f\"dead programs (psi std < 0.01): {(psi.std(1) < 0.01).sum()} / {K}\")\n",
    "print(f\"programs never dominant: {K - len(np.unique(phi.argmax(1)))} / {K}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Do the learned programs track cell identity?\n",
    "\n",
    "If LeafletFA is finding real biology, the per-cell program loadings (`phi`) should organize by\n",
    "cell type / organ system — **without ever having seen those labels**."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1210x660 with 2 Axes>"
      ]
     },
     "metadata": {
      "image/png": {
       "height": 636,
       "width": 1174
      }
     },
     "output_type": "display_data"
    }
   ],
   "source": [
    "phi_df = pd.DataFrame(phi, index=sp_train.obs_names,\n",
    "                      columns=[f\"P{k}\" for k in range(K)])\n",
    "phi_df[\"organ_system\"] = sp_train.obs[\"organ_system\"].values\n",
    "\n",
    "mean_phi = phi_df.groupby(\"organ_system\", observed=True).mean()\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(11, 6))\n",
    "sns.heatmap(mean_phi, cmap=\"viridis\", ax=ax, cbar_kws={\"label\": \"mean phi\"})\n",
    "ax.set_title(\"Mean LeafletFA program loading per organ system\")\n",
    "plt.tight_layout(); plt.show()"
   ]
