    "sp_lat = ad.AnnData(X=phi, obs=sp_train.obs.copy())\n",
    "sp_lat.obsm[\"X_phi\"] = phi\n",
    "sc.pp.neighbors(sp_lat, use_rep=\"X_phi\", n_neighbors=15)\n",
    "sc.tl.umap(sp_lat)\n",
