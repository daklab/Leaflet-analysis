import os
import glob
import subprocess

configfile: "config_tabula_senis_18MO.yaml"

def validate_bam(bam_file):
    """Validate BAM file - check if it exists, has content, and is not corrupt"""
    if not os.path.exists(bam_file):
        return False
    
    # Check file size
    if os.path.getsize(bam_file) == 0:
        print(f"Warning: BAM file {bam_file} is empty (0 bytes)")
        return False
    
    # Check if BAM file is readable with samtools
    try:
        result = subprocess.run(['samtools', 'quickcheck', bam_file], 
                              capture_output=True, text=True, timeout=30)
        if result.returncode != 0:
            print(f"Warning: BAM file {bam_file} failed samtools quickcheck")
            return False
    except (subprocess.TimeoutExpired, subprocess.CalledProcessError, FileNotFoundError):
        print(f"Warning: Could not validate BAM file {bam_file}")
        return False
    
    return True

# Function to map sample IDs to their BAM file paths
def get_sample_ids():
    sample_bam_map = {}
    search_pattern = os.path.join(config["raw_dir"], "*", "results_gencode_ercc", "*.gencode.vM19.ERCC.Aligned.out.sorted.bam")
    for bam_file in glob.glob(search_pattern):
        sample_name = os.path.basename(bam_file).split(".")[0]
        sample_bam_map[sample_name] = bam_file
    return sample_bam_map

sample_bam_map = get_sample_ids()

rule all:
    input:
        expand("{results_dir}/{sample}/junctions_with_barcodes.bed",
               results_dir=config["results_dir"], sample=list(sample_bam_map.keys())),
        expand("{results_dir}/{sample}_splicing_summary.tsv",
               results_dir=config["results_dir"], sample=list(sample_bam_map.keys()))

# Rule to validate BAM file
rule validate_bam:
    input:
        bam = lambda wildcards: sample_bam_map[wildcards.sample]
    output:
        validated = config["results_dir"] + "/{sample}/bam_validated.flag"
    run:
        # Create output directory if it doesn't exist
        os.makedirs(os.path.dirname(output.validated), exist_ok=True)
        
        if validate_bam(input.bam):
            # Create validation flag file
            with open(output.validated, 'w') as f:
                f.write(f"BAM file {input.bam} validated successfully\n")
            print(f"BAM validation passed for {wildcards.sample}")
        else:
            # Create flag file but mark it as failed
            print(f"BAM validation failed for {wildcards.sample}. Skipping downstream processing.")
            with open(output.validated, 'w') as f:
                f.write(f"BAM file {input.bam} validation FAILED\n")

# Rule to add CB tag to BAM files
rule add_cb_tag:
    input:
        bam = lambda wildcards: sample_bam_map[wildcards.sample],
        validated = rules.validate_bam.output.validated
    output:
        bam_CB = config["results_dir"] + "/{sample}/CB.bam"
    run:
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping CB tag addition for {wildcards.sample} due to failed BAM validation")
            # Create empty output file to satisfy Snakemake
            shell("touch {output.bam_CB}")
        else:
            print(f"Processing sample: {wildcards.sample}")
            print(f"Expected BAM path: {input.bam}")
            
            shell("""
            if [[ ! -f "{input.bam}" ]]; then
                echo "ERROR: BAM file {input.bam} not found!"
                exit 1
            fi

            samtools view -h {input.bam} | awk -v cb="{wildcards.sample}" 'BEGIN {{OFS="\\t"}} {{if ($1 ~ /^@/) print; else print $0 "\\tCB:Z:" cb;}}' | samtools view -b - > {output.bam_CB}
            """)

# Rule to index the BAM file
rule index_bam:
    input:
        bam = rules.add_cb_tag.output.bam_CB,
        validated = rules.validate_bam.output.validated
    output:
        bai = config["results_dir"] + "/{sample}/CB.bam.bai"
    run:
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping BAM indexing for {wildcards.sample} due to failed BAM validation")
            # Create empty output file to satisfy Snakemake
            shell("touch {output.bai}")
        else:
            print(f"Indexing BAM file: {input.bam}")
            shell("samtools index {input.bam}")

# Rule to extract junctions with barcodes (without deleting the BAM file)
rule extract_junctions:
    input:
        bam = rules.add_cb_tag.output.bam_CB,
        bai = rules.index_bam.output.bai,
        validated = rules.validate_bam.output.validated
    output:
        juncs = config["results_dir"] + "/{sample}/junctions.bed",
        barcodes = config["results_dir"] + "/{sample}/barcodes.txt",
        juncswbarcodes = config["results_dir"] + "/{sample}/junctions_with_barcodes.bed"
    params:
        regtools_path = config["regtools_path"]
    run:
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping junction extraction for {wildcards.sample} due to failed BAM validation")
            # Create empty output files
            shell("touch {output.juncs} {output.barcodes} {output.juncswbarcodes}")
        else:
            print(f"Extracting junctions with barcodes from BAM file: {input.bam}")
            shell("""
            {params.regtools_path} junctions extract -a 6 -m 50 -M 500000 {input.bam} -o {output.juncs} -s XS -b {output.barcodes}

            # Combine junctions and barcodes
            paste --delimiters='\t' {output.juncs} {output.barcodes} > {output.juncswbarcodes}

            echo "Done extracting junctions with barcodes"
            """)

# Rule to summarize splicing
rule summarize_splicing:
    input:
        bam = rules.add_cb_tag.output.bam_CB,
        juncs = config["results_dir"] + "/{sample}/junctions.bed",
        validated = rules.validate_bam.output.validated
    output:
        summary = config["results_dir"] + "/{sample}_splicing_summary.tsv"
    run:
        # Check if validation passed
        with open(input.validated, 'r') as f:
            validation_content = f.read()
        
        if "validation FAILED" in validation_content:
            print(f"Skipping splicing summary for {wildcards.sample} due to failed BAM validation")
            # Create summary with failure message
            with open(output.summary, 'w') as f:
                f.write("Sample\tTotal_Reads\tSpliced_Reads\tUnspliced_Reads\tStatus\n")
                f.write(f"{wildcards.sample}\t0\t0\t0\tBAM_VALIDATION_FAILED\n")
        else:
            shell("""
            echo -e "Sample\tTotal_Reads\tSpliced_Reads\tUnspliced_Reads\tStatus" > {output.summary}

            sample=$(basename {input.bam} | cut -d'.' -f1)
            total_reads=$(samtools view -c -F 4 {input.bam})

            # Ensure the file has at least five columns before extracting spliced reads
            spliced_reads=$(awk '{{if (NF >= 5) sum += $5}} END {{print (sum == "" ? 0 : sum)}}' "{input.juncs}")

            unspliced_reads=$((total_reads - spliced_reads))

            echo -e "$sample\t$total_reads\t$spliced_reads\t$unspliced_reads\tSUCCESS" >> {output.summary}
            echo "Splicing summary written to {output.summary}"
            """)